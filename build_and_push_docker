#!/usr/bin/env bash

# Stop immediately on any error so a failed build never gets tagged or pushed
set -euo pipefail

# Docker Hub user/namespace to publish to
DOCKER_USER=${DOCKER_USER:-winkler}

# Extract version from version.py
if [ -f "version.py" ]; then
    VERSION=$(python3 -c "from version import VERSION; print(VERSION)")
    echo "Building version: $VERSION"
else
    echo "Error: version.py not found. Please create a version.py file with VERSION defined."
    exit 1
fi

echo "Builds from the local working tree (see .dockerignore). No push needed before building."
echo "Building version: $VERSION and latest (publishing to ${DOCKER_USER})"
# wait 2 seconds
sleep 2

# Build the image
docker build -t aitoolkit:$VERSION -f docker/Dockerfile .

# Tag with version and latest
docker tag aitoolkit:$VERSION ${DOCKER_USER}/aitoolkit:$VERSION
docker tag aitoolkit:$VERSION ${DOCKER_USER}/aitoolkit:latest

# Push both tags
echo "Pushing images to Docker Hub (${DOCKER_USER})..."
docker push ${DOCKER_USER}/aitoolkit:$VERSION
docker push ${DOCKER_USER}/aitoolkit:latest

echo "Successfully built and pushed ${DOCKER_USER}/aitoolkit:$VERSION and ${DOCKER_USER}/aitoolkit:latest"
