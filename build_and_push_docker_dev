#!/usr/bin/env bash

# Docker Hub user/namespace to publish to
DOCKER_USER=${DOCKER_USER:-winkler}

VERSION=dev
GIT_COMMIT=dev

echo "Builds from the local working tree (see .dockerignore). No push needed before building."
echo "Building version: $VERSION (publishing to ${DOCKER_USER})"
# wait 2 seconds
sleep 2

# Build the image
docker build -t aitoolkit:$VERSION -f docker/Dockerfile .

# Tag with version and latest
docker tag aitoolkit:$VERSION ${DOCKER_USER}/aitoolkit:$VERSION

# Push both tags
echo "Pushing images to Docker Hub (${DOCKER_USER})..."
docker push ${DOCKER_USER}/aitoolkit:$VERSION

echo "Successfully built and pushed ${DOCKER_USER}/aitoolkit:$VERSION"
